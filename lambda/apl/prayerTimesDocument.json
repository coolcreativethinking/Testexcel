{
  "type": "APL",
  "version": "2024.2",
  "description": "My Azan - Prayer Times with Iqama, Hijri Date, Fajr End",
  "theme": "dark",
  "mainTemplate": {
    "parameters": [
      "templateData"
    ],
    "items": [
      {
        "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "items": [
          {
            "type": "Image",
            "width": "100vw",
            "height": "100vh",
            "position": "absolute",
            "scale": "best-fill",
            "source": "https://YOUR_CLOUDFRONT_DOMAIN/assets/mosque-bg-1200.png",
            "overlayColor": "rgba(0, 20, 50, 0.85)"
          },
          {
            "type": "Container",
            "width": "100vw",
            "height": "100vh",
            "paddingLeft": "4vw",
            "paddingRight": "4vw",
            "paddingTop": "2vh",
            "items": [
              {
                "type": "Container",
                "direction": "row",
                "justifyContent": "spaceBetween",
                "alignItems": "center",
                "width": "100%",
                "items": [
                  {
                    "type": "Container",
                    "items": [
                      {
                        "type": "Text",
                        "text": "${templateData.properties.title}",
                        "fontSize": "32dp",
                        "fontWeight": "bold",
                        "color": "#FFFFFF"
                      },
                      {
                        "type": "Text",
                        "text": "${templateData.properties.city}",
                        "fontSize": "18dp",
                        "color": "#D4AF37"
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "alignItems": "flexEnd",
                    "items": [
                      {
                        "type": "Text",
                        "text": "${templateData.properties.hijriDate}",
                        "fontSize": "18dp",
                        "color": "#D4AF37"
                      },
                      {
                        "when": "${templateData.properties.isRamadan}",
                        "type": "Text",
                        "text": "Ramadan Mubarak",
                        "fontSize": "16dp",
                        "color": "#90EE90",
                        "fontStyle": "italic"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "width": "100%",
                "height": "2dp",
                "backgroundColor": "#D4AF37",
                "marginTop": "8dp",
                "marginBottom": "8dp",
                "opacity": 0.5
              },
              {
                "type": "Container",
                "direction": "row",
                "justifyContent": "spaceBetween",
                "width": "100%",
                "paddingLeft": "6%",
                "paddingRight": "6%",
                "paddingBottom": "6dp",
                "items": [
                  {
                    "type": "Text",
                    "text": "Prayer",
                    "fontSize": "16dp",
                    "fontWeight": "bold",
                    "color": "#808080",
                    "width": "30%"
                  },
                  {
                    "type": "Text",
                    "text": "Azan",
                    "fontSize": "16dp",
                    "fontWeight": "bold",
                    "color": "#808080",
                    "textAlign": "center",
                    "width": "30%"
                  },
                  {
                    "type": "Text",
                    "text": "Iqama",
                    "fontSize": "16dp",
                    "fontWeight": "bold",
                    "color": "#808080",
                    "textAlign": "right",
                    "width": "30%"
                  }
                ]
              },
              {
                "type": "Container",
                "width": "100%",
                "grow": 1,
                "justifyContent": "spaceEvenly",
                "items": [
                  {
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "width": "100%",
                    "paddingLeft": "6%",
                    "paddingRight": "6%",
                    "paddingTop": "6dp",
                    "paddingBottom": "6dp",
                    "items": [
                      { "type": "Text", "text": "Fajr", "fontSize": "24dp", "fontWeight": "bold", "color": "#FFFFFF", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.prayers.Fajr}", "fontSize": "24dp", "color": "#E0E0E0", "textAlign": "center", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.iqama.Fajr}", "fontSize": "20dp", "color": "#90CAF9", "textAlign": "right", "width": "30%" }
                    ]
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "width": "100%",
                    "paddingLeft": "6%",
                    "paddingRight": "6%",
                    "paddingTop": "4dp",
                    "paddingBottom": "4dp",
                    "items": [
                      { "type": "Text", "text": "Sunrise (Fajr ends)", "fontSize": "18dp", "color": "#FFA726", "width": "50%" },
                      { "type": "Text", "text": "${templateData.properties.prayers.Sunrise}", "fontSize": "18dp", "color": "#FFA726", "textAlign": "center", "width": "30%" },
                      { "type": "Text", "text": "", "width": "30%" }
                    ]
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "width": "100%",
                    "paddingLeft": "6%",
                    "paddingRight": "6%",
                    "paddingTop": "6dp",
                    "paddingBottom": "6dp",
                    "items": [
                      { "type": "Text", "text": "Dhuhr", "fontSize": "24dp", "fontWeight": "bold", "color": "#FFFFFF", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.prayers.Dhuhr}", "fontSize": "24dp", "color": "#E0E0E0", "textAlign": "center", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.iqama.Dhuhr}", "fontSize": "20dp", "color": "#90CAF9", "textAlign": "right", "width": "30%" }
                    ]
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "width": "100%",
                    "paddingLeft": "6%",
                    "paddingRight": "6%",
                    "paddingTop": "6dp",
                    "paddingBottom": "6dp",
                    "items": [
                      { "type": "Text", "text": "Asr", "fontSize": "24dp", "fontWeight": "bold", "color": "#FFFFFF", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.prayers.Asr}", "fontSize": "24dp", "color": "#E0E0E0", "textAlign": "center", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.iqama.Asr}", "fontSize": "20dp", "color": "#90CAF9", "textAlign": "right", "width": "30%" }
                    ]
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "width": "100%",
                    "paddingLeft": "6%",
                    "paddingRight": "6%",
                    "paddingTop": "6dp",
                    "paddingBottom": "6dp",
                    "items": [
                      { "type": "Text", "text": "Maghrib", "fontSize": "24dp", "fontWeight": "bold", "color": "#FFFFFF", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.prayers.Maghrib}", "fontSize": "24dp", "color": "#E0E0E0", "textAlign": "center", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.iqama.Maghrib}", "fontSize": "20dp", "color": "#90CAF9", "textAlign": "right", "width": "30%" }
                    ]
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "width": "100%",
                    "paddingLeft": "6%",
                    "paddingRight": "6%",
                    "paddingTop": "6dp",
                    "paddingBottom": "6dp",
                    "items": [
                      { "type": "Text", "text": "Isha", "fontSize": "24dp", "fontWeight": "bold", "color": "#FFFFFF", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.prayers.Isha}", "fontSize": "24dp", "color": "#E0E0E0", "textAlign": "center", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.iqama.Isha}", "fontSize": "20dp", "color": "#90CAF9", "textAlign": "right", "width": "30%" }
                    ]
                  },
                  {
                    "when": "${templateData.properties.taraweehTime != ''}",
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "spaceBetween",
                    "alignItems": "center",
                    "width": "100%",
                    "paddingLeft": "6%",
                    "paddingRight": "6%",
                    "paddingTop": "6dp",
                    "paddingBottom": "6dp",
                    "items": [
                      { "type": "Text", "text": "Taraweeh", "fontSize": "22dp", "fontWeight": "bold", "color": "#90EE90", "width": "30%" },
                      { "type": "Text", "text": "${templateData.properties.taraweehTime}", "fontSize": "22dp", "color": "#90EE90", "textAlign": "center", "width": "30%" },
                      { "type": "Text", "text": "", "width": "30%" }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "width": "100%",
                "alignItems": "center",
                "paddingBottom": "1vh",
                "items": [
                  {
                    "type": "Text",
                    "text": "Say \"play the Azan\" or \"change reciter\"",
                    "fontSize": "14dp",
                    "color": "#606060",
                    "textAlign": "center"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
