{
  "type": "APL",
  "version": "2024.2",
  "description": "My Azan - Azan Playback Screen",
  "theme": "dark",
  "mainTemplate": {
    "parameters": [
      "templateData"
    ],
    "items": [
      {
        "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "items": [
          {
            "type": "Image",
            "width": "100vw",
            "height": "100vh",
            "position": "absolute",
            "scale": "best-fill",
            "source": "https://YOUR_CLOUDFRONT_DOMAIN/assets/mosque-bg-1200.png",
            "overlayColor": "rgba(0, 15, 40, 0.85)"
          },
          {
            "type": "Container",
            "width": "100vw",
            "height": "100vh",
            "justifyContent": "center",
            "alignItems": "center",
            "items": [
              {
                "type": "Text",
                "text": "&#x2726;",
                "fontSize": "80dp",
                "color": "#D4AF37",
                "textAlign": "center"
              },
              {
                "type": "Text",
                "text": "${templateData.properties.title}",
                "fontSize": "44dp",
                "fontWeight": "bold",
                "color": "#FFFFFF",
                "textAlign": "center",
                "paddingTop": "20dp"
              },
              {
                "type": "Text",
                "text": "${templateData.properties.subtitle}",
                "fontSize": "28dp",
                "color": "#D4AF37",
                "textAlign": "center",
                "paddingTop": "8dp"
              },
              {
                "type": "Container",
                "paddingTop": "48dp",
                "alignItems": "center",
                "items": [
                  {
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "center",
                    "alignItems": "center",
                    "spacing": "8dp",
                    "items": [
                      {
                        "type": "Container",
                        "width": "12dp",
                        "height": "12dp",
                        "borderRadius": "6dp",
                        "backgroundColor": "#D4AF37",
                        "opacity": 0.6
                      },
                      {
                        "type": "Container",
                        "width": "16dp",
                        "height": "16dp",
                        "borderRadius": "8dp",
                        "backgroundColor": "#D4AF37",
                        "opacity": 0.8
                      },
                      {
                        "type": "Container",
                        "width": "20dp",
                        "height": "20dp",
                        "borderRadius": "10dp",
                        "backgroundColor": "#D4AF37"
                      },
                      {
                        "type": "Container",
                        "width": "16dp",
                        "height": "16dp",
                        "borderRadius": "8dp",
                        "backgroundColor": "#D4AF37",
                        "opacity": 0.8
                      },
                      {
                        "type": "Container",
                        "width": "12dp",
                        "height": "12dp",
                        "borderRadius": "6dp",
                        "backgroundColor": "#D4AF37",
                        "opacity": 0.6
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "paddingTop": "32dp",
                "items": [
                  {
                    "type": "Text",
                    "text": "Now Playing",
                    "fontSize": "18dp",
                    "color": "#808080",
                    "textAlign": "center"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
